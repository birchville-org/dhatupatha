  #pad(left: 0.6em)[#text(7.5pt, fill: luma(80))[आप्रवणम् उत्प्लवनम् उत्प्लुत्य गमनं वा ' इति क्षीरतरङ्गिणी । ' उद्धरणम् इति भोजः ' इति धातुवृतौ ।]]
]
