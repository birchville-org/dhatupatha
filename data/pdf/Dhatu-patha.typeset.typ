  #text(8pt, fill: luma(60), style: "italic")[„to be white“]
  \
  #pad(left: 0.6em)[#text(7.5pt, fill: luma(80))[' श्वेतस्य गुणस्यापि धातुना साध्यतया क्रमिकतया च अभिधानात् क्रियात्वम् । यदाह- ' श्वेततेः श्वेत इत्येकं श्वेतत्वेन प्रकाश्यते । आश्रितक्रमरूपत्वादभिधानं प्रवर्तते ' - ( वाक्यपदीयम् 3.3 ) इति ' इति माधवः ।]]
]
