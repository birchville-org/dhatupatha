  \
  #pad(left: 0.6em)[#text(7.5pt, fill: luma(80))[कल्याणम्- मङ्गलम् भद्राकरोति = मुण्डयति, माङ्गल्यगुणेन संस्करोति इत्यर्थः । सुखम् = आत्मगुणः, आत्मगुणोदयो वा ।]]
]
